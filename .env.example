# Site login password (choose your own)
SITE_PASSWORD=change-me

# Random secret for session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional bearer token for external /api/log integrations
LOG_API_TOKEN=

# Optional secure cloud sync. Keep the service key server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
