# Site login password (choose your own)
SITE_PASSWORD=change-me

# Random secret for session cookies — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional "Sign in with Google". Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# <your-site>/api/auth/google/callback. All three values must be set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to sign in.
ALLOWED_GOOGLE_EMAILS=

# Optional bearer token for external /api/log integrations
LOG_API_TOKEN=

# Optional secure cloud sync. Both keys are server-only secrets — never
# prefix them with NEXT_PUBLIC_. Prefer SUPABASE_SECRET_KEY (the new
# sb_secret_... key from Project Settings → API keys); the legacy
# SUPABASE_SERVICE_ROLE_KEY still works as a fallback.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
